<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Montani ATS - Job Applications</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
      color: #333;
      min-height: 100vh;
      padding: 20px;
    }

    .container { max-width: 1400px; margin: 0 auto; }

    /* Header */
    .header {
      background: white;
      padding: 30px;
      border-radius: 12px;
      margin-bottom: 30px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      border-left: 5px solid #0066cc;
    }
    .header h1 { font-size: 32px; color: #0066cc; margin-bottom: 10px; }
    .header p { color: #666; font-size: 14px; }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }
    .stat-card {
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      border-top: 4px solid #0066cc;
    }
    .stat-card.pending { border-top-color: #ff9800; }
    .stat-card.reviewed { border-top-color: #2196F3; }
    .stat-card.hired { border-top-color: #4caf50; }
    .stat-card.rejected { border-top-color: #f44336; }
    
    .stat-label { font-size: 12px; color: #999; text-transform: uppercase; margin-bottom: 5px; }
    .stat-value { font-size: 32px; font-weight: bold; color: #333; }

    /* Controls */
    .controls {
      background: white;
      padding: 20px;
      border-radius: 10px;
      margin-bottom: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .search-box { 
      width: 100%; 
      padding: 12px; 
      border: 1px solid #ddd; 
      border-radius: 6px; 
      font-size: 14px;
      margin-bottom: 15px;
    }
    .filter-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .filter-btn {
      padding: 8px 16px;
      border: 2px solid #ddd;
      background: white;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      transition: all 0.3s;
    }
    .filter-btn:hover { border-color: #0066cc; color: #0066cc; }
    .filter-btn.active { background: #0066cc; color: white; border-color: #0066cc; }

    /* Applicants List */
    .applicants-section {
      background: white;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      overflow: hidden;
    }
    .applicants-table {
      width: 100%;
      border-collapse: collapse;
    }
    .applicants-table th {
      background: #f5f7fa;
      padding: 15px;
      text-align: left;
      font-weight: 600;
      color: #666;
      border-bottom: 1px solid #eee;
      font-size: 12px;
      text-transform: uppercase;
    }
    .applicants-table td {
      padding: 15px;
      border-bottom: 1px solid #eee;
    }
    .applicants-table tr:hover {
      background: #f9f9f9;
      cursor: pointer;
    }

    /* Applicant Row */
    .applicant-name { font-weight: 600; color: #0066cc; }
    .applicant-email { color: #666; font-size: 13px; }
    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .status-pending { background: #fff3e0; color: #ff9800; }
    .status-reviewed { background: #e3f2fd; color: #2196F3; }
    .status-hired { background: #e8f5e9; color: #4caf50; }
    .status-rejected { background: #ffebee; color: #f44336; }

    /* Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .modal.show { display: flex; }
    .modal-content {
      background: white;
      border-radius: 12px;
      width: 90%;
      max-width: 600px;
      max-height: 80vh;
      overflow-y: auto;
      padding: 30px;
      position: relative;
    }
    .modal-close {
      position: absolute;
      top: 15px;
      right: 15px;
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: #999;
    }
    .modal-header { margin-bottom: 20px; border-bottom: 2px solid #f0f0f0; padding-bottom: 15px; }
    .modal-header h2 { color: #0066cc; margin-bottom: 5px; }
    .detail-group { margin-bottom: 20px; }
    .detail-label { font-size: 12px; color: #999; text-transform: uppercase; margin-bottom: 5px; }
    .detail-value { font-size: 14px; color: #333; }
    .action-buttons { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
    .btn {
      padding: 10px 16px;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }
    .btn-primary { background: #0066cc; color: white; }
    .btn-primary:hover { background: #0052a3; }
    .btn-success { background: #4caf50; color: white; }
    .btn-success:hover { background: #3d8b40; }
    .btn-warning { background: #ff9800; color: white; }
    .btn-warning:hover { background: #e68900; }
    .btn-danger { background: #f44336; color: white; }
    .btn-danger:hover { background: #da190b; }

    .empty-state { text-align: center; padding: 60px 20px; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1>📄 Montani Job Applications</h1>
      <p>Manage and track all job applicants</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total Applications</div>
        <div class="stat-value" id="total-stat">0</div>
      </div>
      <div class="stat-card pending">
        <div class="stat-label">Pending Review</div>
        <div class="stat-value" id="pending-stat">0</div>
      </div>
      <div class="stat-card reviewed">
        <div class="stat-label">Reviewed</div>
        <div class="stat-value" id="reviewed-stat">0</div>
      </div>
      <div class="stat-card hired">
        <div class="stat-label">Hired</div>
        <div class="stat-value" id="hired-stat">0</div>
      </div>
      <div class="stat-card rejected">
        <div class="stat-label">Rejected</div>
        <div class="stat-value" id="rejected-stat">0</div>
      </div>
    </div>

    <!-- Controls -->
    <div class="controls">
      <input type="text" id="search-input" class="search-box" placeholder="Search by name, email, or position...">
      <div class="filter-buttons">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="pending">Pending</button>
        <button class="filter-btn" data-filter="reviewed">Reviewed</button>
        <button class="filter-btn" data-filter="hired">Hired</button>
        <button class="filter-btn" data-filter="rejected">Rejected</button>
      </div>
    </div>

    <!-- Applicants Table -->
    <div class="applicants-section">
      <table class="applicants-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Position</th>
            <th>Status</th>
            <th>Applied</th>
          </tr>
        </thead>
        <tbody id="applicants-list">
          <tr><td colspan="5" style="text-align: center; padding: 40px;">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Applicant Detail Modal -->
  <div class="modal" id="applicant-modal">
    <div class="modal-content">
      <button class="modal-close" onclick="closeModal()">✕</button>
      <div class="modal-header">
        <h2 id="modal-name">Applicant Name</h2>
        <p id="modal-email" style="color: #666;"></p>
      </div>
      
      <div class="detail-group">
        <div class="detail-label">Email</div>
        <div class="detail-value" id="modal-email-detail"></div>
      </div>
      <div class="detail-group">
        <div class="detail-label">Phone</div>
        <div class="detail-value" id="modal-phone"></div>
      </div>
      <div class="detail-group">
        <div class="detail-label">Position of Interest</div>
        <div class="detail-value" id="modal-position"></div>
      </div>
      <div class="detail-group">
        <div class="detail-label">Expected Salary</div>
        <div class="detail-value" id="modal-salary"></div>
      </div>
      <div class="detail-group">
        <div class="detail-label">Years of Experience</div>
        <div class="detail-value" id="modal-experience"></div>
      </div>
      <div class="detail-group">
        <div class="detail-label">Tech Stack</div>
        <div class="detail-value" id="modal-techstack"></div>
      </div>
      <div class="detail-group">
        <div class="detail-label">LinkedIn Profile</div>
        <div class="detail-value" id="modal-linkedin"></div>
      </div>
      <div class="detail-group">
        <div class="detail-label">Resume</div>
        <div class="detail-value">
          <a id="modal-resume" href="#" target="_blank" style="color: #0066cc; text-decoration: none;">Download Resume</a>
        </div>
      </div>
      <div class="detail-group">
        <div class="detail-label">Applied On</div>
        <div class="detail-value" id="modal-applied"></div>
      </div>

      <div class="action-buttons">
        <button class="btn btn-success" onclick="updateStatus('reviewed')">Mark Reviewed</button>
        <button class="btn btn-warning" onclick="updateStatus('hired')">Mark Hired</button>
        <button class="btn btn-danger" onclick="updateStatus('rejected')">Mark Rejected</button>
      </div>
    </div>
  </div>

  <script>
    let allApplicants = [];
    let currentFilter = 'all';
    let selectedApplicant = null;

    async function loadApplicants() {
      try {
        const response = await fetch('/api/v1/applicants');
        const data = await response.json();

        if (data.success) {
          allApplicants = data.data;
          updateStats(data);
          renderApplicants();
        }
      } catch (error) {
        console.error('Error loading applicants:', error);
        document.getElementById('applicants-list').innerHTML = '<tr><td colspan="5" class="empty-state">Error loading applicants</td></tr>';
      }
    }

    function updateStats(data) {
      document.getElementById('total-stat').textContent = data.total_count;
      document.getElementById('pending-stat').textContent = data.pending_count;
      document.getElementById('reviewed-stat').textContent = data.reviewed_count;
      document.getElementById('hired-stat').textContent = data.hired_count;
      document.getElementById('rejected-stat').textContent = data.rejected_count;
    }

    function renderApplicants() {
      let filtered = allApplicants;

      if (currentFilter !== 'all') {
        filtered = filtered.filter(a => a.status === currentFilter);
      }

      const searchTerm = document.getElementById('search-input').value.toLowerCase();
      if (searchTerm) {
        filtered = filtered.filter(a =>
          a.first_name.toLowerCase().includes(searchTerm) ||
          a.last_name.toLowerCase().includes(searchTerm) ||
          a.email.toLowerCase().includes(searchTerm) ||
          (a.position_of_interest && a.position_of_interest.toLowerCase().includes(searchTerm))
        );
      }

      if (filtered.length === 0) {
        document.getElementById('applicants-list').innerHTML = '<tr><td colspan="5" class="empty-state">No applicants found</td></tr>';
        return;
      }

      let html = filtered.map(app => `
        <tr onclick="openModal('${app.id}')">
          <td><div class="applicant-name">${app.first_name} ${app.last_name}</div></td>
          <td><div class="applicant-email">${app.email}</div></td>
          <td>${app.position_of_interest || '—'}</td>
          <td><span class="status-badge status-${app.status}">${capitalizeFirst(app.status)}</span></td>
          <td>${formatDate(app.created_at)}</td>
        </tr>
      `).join('');

      document.getElementById('applicants-list').innerHTML = html;
    }

    function openModal(id) {
      selectedApplicant = allApplicants.find(a => a.id == id);
      if (!selectedApplicant) return;

      document.getElementById('modal-name').textContent = `${selectedApplicant.first_name} ${selectedApplicant.last_name}`;
      document.getElementById('modal-email').textContent = selectedApplicant.email;
      document.getElementById('modal-email-detail').textContent = selectedApplicant.email;
      document.getElementById('modal-phone').textContent = selectedApplicant.phone || '—';
      document.getElementById('modal-position').textContent = selectedApplicant.position_of_interest || '—';
      document.getElementById('modal-salary').textContent = selectedApplicant.expected_salary ? `$${selectedApplicant.expected_salary}` : '—';
      document.getElementById('modal-experience').textContent = selectedApplicant.years_of_experience || '—';
      document.getElementById('modal-techstack').textContent = selectedApplicant.tech_stack || '—';
      document.getElementById('modal-linkedin').textContent = selectedApplicant.linkedin_profile ? 
        `<a href="${selectedApplicant.linkedin_profile}" target="_blank">${selectedApplicant.linkedin_profile}</a>` : '—';
      document.getElementById('modal-resume').href = selectedApplicant.resume_url;
      document.getElementById('modal-applied').textContent = formatDate(selectedApplicant.created_at);

      document.getElementById('applicant-modal').classList.add('show');
    }

    function closeModal() {
      document.getElementById('applicant-modal').classList.remove('show');
      selectedApplicant = null;
    }

    async function updateStatus(status) {
      if (!selectedApplicant) return;

      try {
        const response = await fetch(`/api/v1/applicants/${selectedApplicant.id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status })
        });

        if (response.ok) {
          closeModal();
          loadApplicants();
        }
      } catch (error) {
        console.error('Error updating status:', error);
      }
    }

    function capitalizeFirst(str) {
      return str.charAt(0).toUpperCase() + str.slice(1);
    }

    function formatDate(dateStr) {
      return new Date(dateStr).toLocaleDateString('en-US', { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric' 
      });
    }

    // Event listeners
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        e.target.classList.add('active');
        currentFilter = e.target.dataset.filter;
        renderApplicants();
      });
    });

    document.getElementById('search-input').addEventListener('input', renderApplicants);
    document.getElementById('applicant-modal').addEventListener('click', (e) => {
      if (e.target.id === 'applicant-modal') closeModal();
    });

    // Load on page load
    loadApplicants();
  </script>
</body>
</html>
